{
	// Type-checks the rendered view webview code (browser + DOM). Bundled by esbuild.js.
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"module": "ES2022",
		"moduleResolution": "Bundler",
		"lib": [
			"ES2022",
			"DOM",
			"DOM.Iterable"
		],
		"noEmit": true
	},
	"include": [
		"src/webview/**/*.ts"
	],
	"exclude": []
}
